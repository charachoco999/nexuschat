# Supabase service role key: use only on your own computer; never commit .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Cloudflare R2 S3 API credentials. Create a token with Object Read & Write
# scoped only to the nexus-edge-media bucket.
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=nexus-edge-media
EDGE_PUBLIC_URL=https://api.nexuscollective.app
